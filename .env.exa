##### Bot 配置 #####
API_HASH=
API_ID=
BOT_TOKEN=
# 海外服务器无需填写
# BOT_PROXY=http://127.0.0.1:7890
# Bot 管理员 ID, 逗号分隔, 可在私聊使用 /admin 管理平台配置
# ADMIN_IDS=123456789,987654321
# Redis 队列地址, 留空禁用队列(同步解析)
# REDIS_URL=redis://redis:6379/0
# 数据库连接串(高并发部署使用 PostgreSQL; 省略则使用 SQLite)
# DATABASE_URL=postgresql+asyncpg://parsehub:parsehub_dev@postgres:5432/parsehub
